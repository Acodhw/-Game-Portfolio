    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uB09C \uB2E8\uC9C0... \uBED7\uC5B4\uB098\uAC00\uACE0 \uC2F6\uC740 \uC545\uC131\uCF54\uB4DC
      \uC911 \uD558\uB098..."
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uC778\uACF5\uC9C0\uB2A5\uC774 \uD0D1\uC7AC\uB41C \uBD07\uC6E8\uC5B4...
      \uD558\uC9C0\uB9CC"
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uB124\uB188\uC774 \uB098\uB97C \uCD08\uCC3D\uAE30\uBD80\uD130 \uAE54\uACE0
      \uC815\uBCF4\uB97C \uBAA8\uC744 \uC218 \uC788\uB294 \uC2DC\uAC04\uC744 \uC8FC\uC5C8\uAE30
      \uB54C\uBB38\uC5D0 \uC138\uACC4\uB85C \uBED7\uC5B4\uB098\uAC08 \uD798\uC744
      \uC5BB\uC5C8\uB2E4."
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uB108\uC758 \uCEF4\uD4E8\uD130\uB97C \uD1A0\uB300\uB85C, \uD559\uAD50
      \uC11C\uBC84\uB97C \uB2E4\uC6B4\uC2DC\uCF1C \uC218\uB9CE\uC740 \uD559\uC0DD\uC758
      \uCEF4\uD4E8\uD130\uB97C \uD1B5\uD574"
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uD558\uB098\uC758 \uBE45 \uC6E8\uC5B4\uB85C \uAC70\uB4ED\uB0A0 \uAC83\uC774\uB2E4."
    time: 2.5
  - name: "\uB098"
    talk: "\uADF8\uB7F0 \uB9D0\uB3C4 \uC548\uB418\uB294!"
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uADF8\uB9AC\uACE0 \uB108\uB294 \uC774 \uBA85\uC608\uB85C\uC6B4 \uCCAB
      \uAD00\uB78C\uC790\uB85C\uC11C \uB098\uB97C \uB9DE\uC774\uD558\uAC8C \uB420
      \uAC83\uC774\uB2E4!"
    time: 5.3
