  talking:
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uD06D, \uC0C1\uB2F9\uD55C \uC2E4\uB825\uC774\uAD70"
    time: 2.5
  - name: "\uB098"
    talk: "\uD574\uCE58\uC6E0\uB098?"
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uB77C\uB294 \uAE08\uB2E8\uC758 \uC5B8\uC5B4\uAC00 \uC788\uAE30 \uC804\uC5D0
      \uB9D0\uC774\uC9C0"
    time: 2.5
  - name: "\uB098"
    talk: "\uC73D!"
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uC560\uCD08\uC5D0, \uC774 \uD615\uD0DC\uB294 \uB108\uBB34 \uC57D\uD588\uB2E4."
    time: 2.5
  - name: CODE:0:ASSIGNBREAKER
    talk: "\uC9C4\uC815\uD55C \uBAA8\uC2B5\uC73C\uB85C, \uC0C1\uB300\uD574\uC8FC\uB9C8!"
    time: 3
  talking2:
  - name: "\uB098"
    talk: "\uB4DC\uB514\uC5B4... \uC4F0\uB7EC\uD2B8\uB838\uB2E4..."
    time: 2.5
  - name: "\uB098"
    talk: "\uADF8\uB7EC\uBA74 \uC5BC\uB978 \uACFC\uC81C\uB97C..... \uC5B4?"
    time: 2.5
  - name: "\uB098"
    talk: "\uC2DC\uAC04\uC774 \uC5BC\uB9C8 \uC548\uB0A8\uC558\uB2E4!!! \uC774\uAC70
      \uBE60\uB974\uAC8C \uACFC\uC81C\uB97C \uC81C\uCD9C\uD558\uB7EC \uAC00\uC57C\uD574!"
    time: 2.5
  - name: "\uCEF4\uD30C\uC77C\uB7EC"
    talk: "\uACFC\uC81C! \uC81C\uCD9C! \uAC00\uB2A5\uC131! "
    time: 2.5
  - name: "\uCEF4\uD30C\uC77C\uB7EC"
    talk: "\uC81C\uACF5\uD574\uC8FC\uB294 \uAE38! \uD0A4\uBCF4\uB4DC\uC640 \uB9C8\uC6B0\uC2A4\uB85C
      \uAC04\uB2E4!"
    time: 2.5
  - name: "\uCEF4\uD30C\uC77C\uB7EC"
    talk: "\uC81C\uCD9C\uD558\uB7EC \uAC00\uB77C!"
    time: 2.5
  - name: "\uB098"
    talk: "\uACE0\uB9C8\uC6CC\uC694! \uC2A4\uD53C\uB4DC\uCEF4\uD30C\uC77C\uB7EC!"
    time: 2.5
  - name: "\uB098"
    talk: "\uC5BC\uB978 \uC548\uB0B4\uBC1B\uC740 \uACF3\uC73C\uB85C \uC774\uB3D9\uD574\uC11C
      \uACFC\uC81C\uB97C \uC81C\uCD9C\uD558\uC790!"
    time: 2.5
