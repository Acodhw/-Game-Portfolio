--- !u!114 &1358313118
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1358313116}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4eb4839bfdd63c42a2fc92f012e6a91, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  talking:
  - name: "\uB098"
    talk: "\uC774\uC81C \uACE7 CPU\uB85C \uAC00\uB294 \uAE38\uC778\uB370... \uC800
      \uC774\uC0C1\uD55C \uBAA9\uB9C8\uB294 \uBB50\uC57C?"
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uD2B8\uB85C\uC774\uBAA9\uB9C8\uB77C\uACE0 \uD55C\uB2E4. \uC800\uB140\uC11D\uC740
      \uBA54\uBAA8\uB9AC\uC5D0 \uC8FC\uAD6C\uC7A5\uCC3D \uC549\uC544\uC11C \uB370\uC774\uD130\uB97C
      \uD6D4\uCCD0\uAC00\uC9C0."
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uBFD0\uB9CC \uC544\uB2C8\uB77C \uBC14\uC774\uB7EC\uC2A4\uAE4C\uC9C0 \uBFCC\uB824\uB300\uB294
      \uC2EC\uAC01\uD55C \uC218\uC900\uC758 \uC801\uC774\uC57C."
    time: 2.5
  - name: "\uB098"
    talk: "\uADF8\uB7F0 \uC704\uD611\uC801\uC778 \uBC14\uC774\uB7EC\uC2A4\uB3C4 \uC788\uC744\uC904\uC774\uC57C."
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uB204\uAD70\uAC00\uAC00 \uD06C\uB799 \uD30C\uC77C\uC744 \uB2E4\uC6B4\uBC1B\uC9C0
      \uC54A\uC558\uB2E4\uBA74 \uC5C6\uC5C8\uC744 \uAC83\uC774\uC9C0\uB9CC..."
    time: 2.5
  - name: "\uB098"
    talk: "\uD06C\uD760....."
    time: 2.5
  - name: "\uB098"
    talk: "\uADF8\uB7EC\uBA74, \uACFC\uC624\uB97C \uCCAD\uC0B0\uD558\uB3C4\uB85D
      \uD558\uC9C0!"
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uAC15\uB825\uD55C \uC801\uC774\uB2C8, \uBC31\uC2E0 \uCF54\uB4DC\uB97C
      \uC774\uC6A9\uD558\uB3C4\uB85D"
    time: 2.5
