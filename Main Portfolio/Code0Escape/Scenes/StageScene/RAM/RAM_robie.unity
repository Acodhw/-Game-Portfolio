  m_Script: {fileID: 11500000, guid: 0a254d33888a7274793695202305b8f7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  talking:
  - name: "\uB098"
    talk: "\uB10C \uB204\uAD6C\uC9C0?"
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uB098\uB294 \uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790. \uD504\uB85C\uADF8\uB7A8\uC774
      \uC791\uB3D9\uD558\uAC70\uB098 \uC885\uB8CC\uB420\uB54C \uD560\uB54C \uBC1C\uC0DD\uD558\uB294
      \uBA54\uBAA8\uB9AC \uBCC0\uD654\uB97C \uAD00\uB9AC\uD558\uC9C0."
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uBA54\uBAA8\uB9AC\uC5D0\uB294 \uB9D0 \uADF8\uB300\uB85C \uC5EC\uB7EC
      \uB370\uC774\uD130\uB4E4\uC774 \uC313\uC774\uACE0 \uB0B4\uB824\uAC04\uB2E8
      \uB9D0\uC774\uC9C0."
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uB108\uB294... \uC0C8\uB85C\uC6B4 \uB370\uC774\uD130\uC778\uAC00 \uC544\uB2C8\uBA74
      \uBC14\uC774\uB7EC\uC2A4\uC778\uAC00?"
    time: 2.5
  - name: "\uB098"
    talk: "\uB098\uB294 \uC0AC\uB78C\uC774\uC57C... \uC5B4\uCA4C\uB2E4\uBCF4\uB2C8
      \uBE60\uC838\uBC84\uB838\uB294\uB370 \uD0C8\uCD9C\uD560 \uBC29\uBC95\uC744
      \uCC3E\uACE0\uC2F6\uC5B4"
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uC74C... \uBC14\uC774\uB7EC\uC2A4\uB97C \uC774\uACF3\uC5D0 \uBD88\uB7EC\uB4DC\uB9B0
      \uC7A5\uBCF8\uC778\uC778\uAC00?"
    time: 2.5
  - name: "\uB098"
    talk: "\uB0B4\uAC00?"
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uD06C\uB799 \uD30C\uC77C\uC774\uB098 \uBD88\uBC95 \uB2E4\uC6B4\uB85C\uB4DC
      \uD588\uC5B4 \uC548\uD588\uC5B4?"
    time: 2.5
  - name: "\uB098"
    talk: ........
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uADF8\uAC83\uC774 \uC6D0\uC778\uC774 \uB418\uC11C \uCEF4\uD4E8\uD130\uAC00
      \uB9DD\uAC00\uC9C0\uACE0 \uC788\uB2E4\uACE0."
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uC790, \uC800\uAE30 \uBCF4\uC774\uB294 \uAC80\uC740 \uAD6C\uCCB4\uB85C
      \uAC00\uBA74 CPU\uB85C \uAC00\uB294 \uD1B5\uB85C\uAC00 \uC5F4\uB9B0\uB2E4."
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uD558\uC9C0\uB9CC \uBC14\uC774\uB7EC\uC2A4\uB85C \uC778\uD574 \uBA54\uBAA8\uB9AC\uAC00
      \uC790\uAFB8\uB9CC \uBCC0\uD574\uC11C \uAC00\uB294 \uD1B5\uB85C\uB3C4 \uACC4\uC18D
      \uBC14\uB00C\uACE0 \uC788\uB2E4."
    time: 2.5
  - name: "\uBA54\uBAA8\uB9AC \uAD00\uB9AC\uC790"
    talk: "\uB9CC\uC77C \uB108\uAC00 CODE:0:ASSIGNBREAKER\uB97C \uBC15\uC0B4\uB0B4\uACE0
      \uD0C8\uCD9C\uD558\uACE0 \uC2F6\uB2E4\uBA74 \uB3C4\uC804\uD574\uBD10\uB77C."
    time: 2.5
