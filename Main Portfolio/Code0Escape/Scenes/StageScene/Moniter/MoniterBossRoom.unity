  NextRoom: RAM_robie
  Boss: {fileID: 1330201670}
  NextEventTime: 39
  talking:
  - name: "\uB098"
    talk: "\uD734... \uB79C\uC12C\uC6E8\uC5B4\uB97C \uD574\uCE58\uC6E0\uB2E4."
    time: 2.5
  - name: HDMI
    talk: "\uC74C. \uC798\uD588\uB2E4. \uB4DC\uB514\uC5B4 \uC774 \uCEF4\uD4E8\uD130\uAC00
      \uC870\uAE08\uC740 \uC815\uC0C1\uC774 \uB418\uC5C8\uAD70,"
    time: 2.5
  - name: "\uB098"
    talk: "\uC870\uAE08\uC740?"
    time: 2.5
  - name: HDMI
    talk: "\uC774 \uCEF4\uD4E8\uD130\uB294 \uC608\uC804\uBD80\uD130 \uACC4\uC18D\uD574\uC11C
      \uB9DD\uAC00\uC9C0\uACE0 \uC788\uC5C8\uC5B4."
    time: 2.5
  - name: HDMI
    talk: "CODE:0:ASSIGNBREAKER\uB77C\uB294 \uB140\uC11D\uC774 \uC624\uACE0 \uB098\uC11C
      \uB9D0\uC774\uC9C0."
    time: 2.5
  - name: "\uB098"
    talk: "\uBB50? \uADF8\uAC74 \uC124\uB9C8....."
    time: 2.5
  - name: HDMI
    talk: "\uC9C0\uAE08\uAECF \uACC4\uC18D \uCEF4\uD4E8\uD130\uAC00 \uBA48\uCD94\uACE0
      \uADF8\uB7F0 \uC774\uC720\uAC00 \uBC14\uB85C \uADF8 \uD504\uB85C\uADF8\uB7A8
      \uB54C\uBB38\uC774\uB2E4."
    time: 2.5
  - name: HDMI
    talk: "\uB108\uB97C \uC5EC\uAE30\uC5D0 \uBD88\uB7EC\uB4DC\uB9B0\uAC83\uB3C4 \uADF8
      \uB140\uC11D\uC774\uACA0\uC9C0."
    time: 2.5
  - name: HDMI
    talk: "\uC74C... \uADF8\uB7EC\uBA74 \uB108\uB294 \uADF8\uB140\uC11D\uC744 \uC4F0\uB7EC\uD2B8\uB824\uC57C\uB9CC
      \uD55C\uB2E4."
    time: 2.5
  - name: "\uB098"
    talk: "\uC5B4? \uD558\uC9C0\uB9CC \uB09C \uACFC\uC81C\uB97C...."
    time: 1
  - name: HDMI
    talk: "\uB140\uC11D\uC744 \uC4F0\uB7EC\uD2B8\uB9AC\uC9C0 \uBABB\uD558\uB294 \uC774\uC0C1
      \uB108\uC758 \uACFC\uC81C\uB3C4 \uD568\uAED8 \uB0A0\uC544\uAC08 \uAC83\uC774\uACE0"
    time: 2.5
  - name: HDMI
    talk: "\uC2EC\uD558\uBA74 \uB140\uC11D\uC774 \uB124\uD2B8\uC6CC\uD06C\uB97C \uD1B5\uD574
      \uD559\uAD50 \uC11C\uBC84\uB97C \uB9DD\uAC00\uD2B8\uB9B4\uC9C0\uB3C4 \uBAB0\uB77C."
    time: 2.5
  - name: HDMI
    talk: "\uADF8\uB807\uAC8C \uB418\uBA74 \uB108\uC5D0\uAC8C \uC5C4\uCCAD\uB09C
      \uC190\uD574\uB85C \uB3CC\uC544\uC62C\uD150\uB370?"
    time: 2.5
  - name: "\uB098"
    talk: "\uC73D... \uADF8\uB7EC\uBA74 ASSIGNBREAKER\uC778\uAC00 \uBB54\uAC00 \uADF8\uB140\uC11D\uC744
      \uC7A1\uC73C\uBA74 \uB418\uC9C0?"
    time: 2.5
  - name: HDMI
    talk: "\uADF8\uB807\uB2E4. \uADF8\uB7EC\uBA74, \uB140\uC11D\uC73C\uB85C \uAC00\uB294
      \uAE38\uC744 \uC548\uB0B4\uD574\uC8FC\uC9C0."
    time: 2.5
  - name: HDMI
    talk: "RAM\uC73C\uB85C \uAC00\uB294 \uD1B5\uB85C\uB97C \uC5F4\uC5C8\uB2E4. \uC790,
      CODE:0:ASSIGNBREAKER\uB97C \uC4F0\uB7EC\uD2B8\uB824\uB77C."
    time: 2.5
