MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 272966140}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4eb4839bfdd63c42a2fc92f012e6a91, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  talking:
  - name: "\uB098"
    talk: "\uBB50\uC57C \uC800\uAC74....."
    time: 2.5
  - name: "\uB79C\uC12C\uC6E8\uC5B4"
    talk: "\uB79C\uC12C\uC6E8\uC5B4 \uAC00\uB3D9... \uBAA8\uB4E0 \uD30C\uC77C\uC744
      \uC7A0\uAC00 \uC218\uC775\uC744 \uCC3D\uCD9C\uD558\uB77C"
    time: 2.5
  - name: "\uB098"
    talk: "\uD30C\uC77C\uC744... \uC7A0\uADFC\uB2E4\uACE0? \uB0B4 \uACFC\uC81C\uAC00
      \uB0A0\uC544\uAC08 \uC218 \uC788\uB2E8 \uB9D0\uC774\uC57C?"
    time: 2.5
  - name: "\uB098"
    talk: "\uADF8\uB807\uAC8C \uB450\uC9C4 \uC54A\uACA0\uC5B4! \uAC70\uC758 \uB2E4
      \uD588\uB2E8 \uB9D0\uC774\uC57C!"
    time: 2.5
  - name: HDMI
    talk: "\uC544, \uC544\uAE4C \uB3C4\uC640\uC900 \uC0AC\uB78C. \uB4E4\uB9AC\uB098?"
    time: 2.5
  - name: "\uB098"
    talk: "\uC774 \uBAA9\uC18C\uB9AC\uB294?"
    time: 2.5
  - name: HDMI
    talk: "\uB098\uB2E4. HDMI"
    time: 2.5
  - name: HDMI
    talk: "\uC544\uBB34\uB798\uB3C4 \uB79C\uC12C\uC6E8\uC5B4\uC5D0 \uAC78\uB824\uC11C
      \uC774\uB3D9\uD558\uB294 \uACFC\uC815\uC5D0 \uD544\uC694\uD55C \uB370\uC774\uD130\uAC00
      \uB9DD\uAC00\uC838\uC11C \uADF8 \uAE38\uC774 \uB9C9\uC600\uB358 \uAC70\uC600\uC5B4."
    time: 2.5
  - name: HDMI
    talk: "\uC870\uC2EC\uD574. \uB79C\uC12C\uC6E8\uC5B4\uB294 \uB9C9\uAC15\uD558\uB2E4.
      <color=#ffff33>\uBC31\uC2E0 \uCF54\uB4DC\uAC00 \uD0D1\uC7AC\uB41C \uCD1D\uC54C</color>\uC774
      \uC544\uB2C8\uBA74 \uD53C\uD574\uB97C \uC904 \uC218 \uC5C6\uC744 \uAC70\uC57C."
    time: 2.5
  - name: "\uB098"
    talk: "\uD558\uC9C0\uB9CC... \uB09C \uB0B4 \uACFC\uC81C\uB97C \uB9C8\uCCD0\uC57C\uB9CC
      \uD55C\uB2E4!"
    time: 2.5
  - name: "\uB098"
    talk: "\uB79C\uC12C\uC6E8\uC5B4\uB97C \uC4F0\uB7EC\uD2B8\uB9AC\uACE0, \uD0C8\uCD9C\uD574\uC11C
      \uACFC\uC81C\uB97C \uB0B4\uACE0\uC57C \uB9D0\uACA0\uC5B4!"
    time: 2.5
