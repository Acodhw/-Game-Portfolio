  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a254d33888a7274793695202305b8f7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  talking:
  - name: "\uB098"
    talk: "\uB108\uB294 \uB204\uAD6C\uC9C0?"
    time: 1.5
  - name: HDMI
    talk: "\uB098\uB294 HDMI. \uCEF4\uD4E8\uD130\uC758 \uADF8\uB798\uD53D \uC815\uBCF4\uB97C
      \uC774 \uBAA8\uB2C8\uD130\uB85C \uC804\uB2EC\uD558\uB294 \uC5ED\uD560\uC744
      \uD55C\uB2E4."
    time: 1.5
  - name: HDMI
    talk: "\uD558\uC9C0\uB9CC, \uC9C0\uAE08 \uD1B5\uB85C\uAC00 \uB9C9\uD600\uBC84\uB9AC\uB294
      \uBC14\uB78C\uC5D0 \uC81C\uB300\uB85C \uD65C\uB3D9\uC744 \uD560 \uC218\uAC00
      \uC5C6\uAD70."
    time: 2.5
  - name: HDMI
    talk: "\uC774\uB7F4\uB54C\uB97C \uB300\uBE44\uD574\uC11C 2\uAC00\uC9C0\uC758
      \uAE30\uBCF8 \uBE44\uC0C1 \uC2A4\uC704\uCE58\uB97C \uB9CC\uB4E4\uC5B4\uB1A8\uC9C0."
    time: 2.5
  - name: "\uB098"
    talk: "\uAE30\uBCF8 \uBE44\uC0C1 \uC2A4\uC704\uCE58\uB77C\uB2C8?"
    time: 2.5
  - name: HDMI
    talk: "\uD2B9\uC218\uD55C \uC6C0\uC9C1\uC784\uC744 \uAC00\uC9C4 \uCD1D\uC54C\uB85C
      \uB204\uB97C \uC218 \uC788\uB294 \uBE44\uC0C1 \uC2A4\uC704\uCE58\uB2E4."
    time: 2.5
  - name: HDMI
    talk: "\uC8FC\uC704\uC5D0 \uB178\uB780\uC0C9\uC73C\uB85C \uBE5B\uB098\uB294 \uAC8C
      \uC788\uC73C\uBA74 \uC2A4\uC704\uCE58\uB2C8\uAE4C \uD655\uC778\uD574\uBD10\uB77C."
    time: 2.5
  - name: HDMI
    talk: "\uC8FC\uC704\uB97C \uB458\uB7EC\uBD10\uB77C. \uADF8\uB9AC\uACE0 \uC5EC\uAE30
      \uB9C9\uD78C \uAD6C\uB97C \uCE58\uC6CC\uC8FC\uC5B4\uB77C."
    time: 2.5
