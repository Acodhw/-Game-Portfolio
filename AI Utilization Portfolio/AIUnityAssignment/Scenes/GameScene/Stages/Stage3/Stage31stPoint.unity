              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
    - speakerName: '{PlayerName}'
      text: "... \uC0C8\uB85C\uC6B4 \uD798\uC774 \uBB54\uAC00 \uB290\uAEF4\uC9C4\uB2E4.."
      duration: 3
      onStepEvent:
        m_PersistentCalls:
          m_Calls: []
    - speakerName: '{PlayerName}'
