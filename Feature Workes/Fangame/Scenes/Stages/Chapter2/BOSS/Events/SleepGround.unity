    - "\uC0AD\uAD70"
    - "\uC7A0\uB730"
    talking:
    - "\uD0D1\uC5D0 \uC0C8\uB85C\uC6B4 \uB3C4\uC804\uC790\uAC00 \uB098\uD0C0\uB0AC\uB2E4\uACE0
      \uC54C\uB78C\uC774 \uC654\uAE38\uB808 \uB610 \uC624\uB958\uC778\uC904 \uC54C\uC558\uB354\uB2C8"
    - "\uC9C4\uC9DC \uB3C4\uC804\uC790\uAC00 \uC640\uC788\uC5C8\uAD70."
    - "\uB204\uAD6C\uC138\uC694?"
    - "\uB0B4 \uC774\uB984\uC740 \uC7A0\uB730, \uC774 \uD0D1\uC758 \uC8FC\uC778\uC774\uC790,
      \uD798\uC758 \uC2DC\uB828\uC7A5\uC774\uC57C!"
    - "\uC774 \uD0D1\uC740 \uACFC\uAC70 \uC138 \uD798\uC758 \uC2E0\uC5D0\uAC8C \uC6A9\uC0AC\uAC00
      \uC790\uC2E0\uC758 \uC2E4\uB825\uC744 \uC778\uC815\uBC1B\uACE0 \uD798\uC744
      \uBC1B\uAE30 \uC704\uD574 \uC138\uC6CC\uC9C4 \uAC70\uC57C."
    - "\uB108\uB3C4 \uB3C4\uC804\uC790\uB2C8, \uB0B4 \uC2DC\uB828\uC744 \uD1B5\uACFC\uD558\uBA74,
      \uAC15\uB825\uD55C \uAE30\uC220\uC778 '\uACE0\uB798 \uC2F8\uC74C'\uC744 \uC804\uC218\uD574\uC8FC\uC9C0,"
    - "\uB124!"
    - "\uC790, \uADF8\uB7FC \uB0A0 \uC4F0\uB7EC\uD2B8\uB824\uBD10!"
    illust:
