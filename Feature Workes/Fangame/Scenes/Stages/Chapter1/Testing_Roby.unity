  td:
    name:
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uC0AD\uAD70"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    - "\uB9C8\uC778\uC560\uD50C"
    talking:
    - "\uBB54\uAC00 \uB2EC\uB77C\uC9C4\uAC8C \uB290\uAEF4\uC838?"
    - "... \uBB54\uAC00 \uC5B4\uB5A4\uAC78 \uD560 \uC218 \uC788\uAC8C \uB41C \uAC70
      \uAC19\uC544\uC694."
    - "\uB0B4\uAC00 \uB108\uC758 \uC801\uC131\uC744 \uB9DE\uCDB0\uC11C \uB2A5\uB825\uC744
      \uC92C\uC5B4."
    - "Q\uB85C \uC0AC\uACFC\uC528\uB97C \uBC1C\uC0AC\uD560 \uC218 \uC788\uC5B4."
    - "\uADF8\uAC78\uB85C \uACF5\uACA9\uD558\uBA74 \uB3FC."
    - "\uADF8\uB9AC\uACE0 T\uB85C \uB108\uC758 \uC2A4\uD0AC\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC5B4."
    - "\uC9C0\uAE08\uC740 \uC2A4\uD0AC\uC774 \uD558\uB098\uB2C8\uAE4C \uADF8\uAC78
      \uC368\uC57C\uACA0\uC9C0?"
    - "\uADF8\uB7EC\uBA74 \uC774\uC81C\uBD80\uD130 \uC2DC\uD5D8\uC758 \uB8F0\uC744
      \uC54C\uB824\uC904\uAED8."
    - "\uC774\uACF3\uC5D0\uB294 \uCD1D 4\uAC1C\uC758 \uC2DC\uB828\uC758 \uD0D1\uC774
      \uC788\uC5B4."
    - "\uADF8 \uD0D1\uC744 \uC62C\uB77C \uAF2D\uB300\uAE30\uC758 \uC0AC\uC2AC\uC744
      \uBD80\uC218\uACE0"
    - "\uCD5C\uC885\uC801\uC73C\uB860 \uB098\uC758 \uC2E0\uC218\uC640 \uC0C1\uB300\uD574\uC11C
      \uC774\uAE30\uBA74 \uB3FC."
    - "\uB098\uB294 \uC5EC\uAE30\uC11C \uC0AC\uACFC\uB97C \uD314 \uD14C\uB2C8, \uC0AC\uACFC\uB97C
      \uC0AC\uACE0 \uC2F6\uC73C\uBA74 \uB098\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uC5B4."
    - "\uC790, \uADF8\uB7EC\uBA74 \uC2DC\uD5D8 \uC2DC\uC791!"
    illust:
    - {fileID: 21300000, guid: e694a55b29b6a7a40a71d6a06c5d1d61, type: 3}
    - {fileID: 21300000, guid: 42da8f4b0228d004c9ce11db443393bb, type: 3}
    - {fileID: 21300000, guid: e694a55b29b6a7a40a71d6a06c5d1d61, type: 3}
