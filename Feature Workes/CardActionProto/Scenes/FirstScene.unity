      \uACBD\uB85C\uB85C \uD50C\uB808\uC774\uC5B4 \uCABD\uC73C\uB85C \uBAA8\uC774\uBA70
      \uAC01 \uAD6C\uCCB4\uB294 <color=#eeee00>\uC804\uAE30 \uC18D\uC131</color>
      <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n\uC804\uAE30
      \uAD6C\uCCB4\uAC00 \uC790\uC2E0\uC5D0\uAC8C \uBAA8\uC774\uB294 \uC21C\uAC04\uC5D0
      \uC7AC\uC2DC\uC804 \uC2DC :\n\uC790\uC2E0 \uC8FC\uBCC0\uC5D0 <color=#c9ff99>\uBE5B
      \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C
      \uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70><i>\uC774 \uC2A4\uD0AC\uC758 \uC7AC\uC2DC\uC804\uC740
      \uAD70\uC911\uC81C\uC5B4\uAE30\uC5D0 \uAC78\uB838\uAC70\uB098 \uB2E4\uB978
      \uC2A4\uD0AC \uC0AC\uC6A9 \uB3C4\uC911\uC5D0\uB3C4 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</i></color>\n<color=#FFFF70>\uD558\uB098\uC758
      \uC804\uAE30 \uAD6C\uCCB4 \uC704\uB825 : 90 INT</color>\n<color=#FFFF70>\uC7AC\uC2DC\uC804
      \uC704\uB825 : 200 INT(+ 150 ATK)</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
      : 20\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 85</color>"
