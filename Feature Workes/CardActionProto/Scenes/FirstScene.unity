    skillName: "\uD2B9\uC774\uC810 \uBD95\uAD34"
    skillInfo: "\uC77C\uC815 \uBC94\uC704\uC758 \uBAA8\uB4E0 \uC801\uC744 <color=#ffa70d>\uB04C\uC5B4
      \uB2F9\uAE34 \uD6C4</color> \uBC94\uC704 \uC548\uC758 \uC801\uC744 <color=#ffc662>\uB454\uD654
      \uC2DC\uD0B5\uB2C8\uB2E4</color>. 1.5\uCD08 \uD6C4 \uC790\uC2E0\uC758 \uC8FC\uBCC0\uC744
      \uD3ED\uBC1C\uC2DC\uCF1C <color=#ff98ef>\uBB34\uC18D\uC131 \uB9C8\uBC95 \uD53C\uD574</color>\uB97C
