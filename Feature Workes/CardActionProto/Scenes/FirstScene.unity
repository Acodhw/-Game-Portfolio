--- !u!114 &181198938
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 181198936}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2611babead49a245846fb5c0f9d4314, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterCode: 1
  characterName: "\uB8E8\uC2DC\uC5D8\uB9AC"
  characterInfo: "\uACFC\uAC70 \uBCC4\uC758 \uC0AC\uC790\uB77C\uB294 \uC874\uC7AC\uC5D0\uAC8C\uC11C
    \uBD80\uBAA8\uB2D8\uC744 \uC783\uC740 \uD6C4, \uC904\uACE7 \uC790\uC2E0\uC774
    \uAC00\uC9C4 \uBCC4\uC758 \uD798\uC744 \uC800\uC8FC\uB85C \uC5EC\uACBC\uB2E4.
    \uD558\uC9C0\uB9CC \uC774\uD6C4 \uBCC4\uC758 \uD798\uC758 \uB73B\uACFC \uC0AC\uC6A9
    \uBC29\uBC95\uC744 \uC54C\uAC8C \uB41C \uC774\uD6C4\uB85C\uB294 \uC774 \uD798\uC744
    \uC633\uAC8C \uC4F0\uACE0\uC790 \uD55C\uB2E4.\n\n\uBB34\uAE30 : \uBCC4\uC758
    \uC644\uB4DC\n\uBCC4\uC758 \uB9C8\uB825\uC744 \uB04C\uC5B4\uB0B4 \uCDA9\uBD84\uD55C
    \uC704\uB825\uC744 \uB0B4\uB3C4\uB85D \uB3C4\uC640\uC8FC\uB294 \uC9C0\uD321\uC774\uC785\uB2C8\uB2E4."
  passiveOn: 1
  passive:
    Icon: {fileID: 1270992883, guid: e61aa29d1f082b4469625103dea48216, type: 3}
    Name: "\uBCC4\uC758 \uB9C8\uB825"
    Info: "\uB8E8\uC2DC\uC5D8\uB9AC\uC758 \uAE30\uBCF8 \uACF5\uACA9\uC774 \uC9C0\uB825\uC744
      \uC0AC\uC6A9\uD558\uC5EC <color=#ff98ef>\uBB34\uC18D\uC131 \uB9C8\uBC95 \uD53C\uD574</color>\uB97C
      \uC785\uD788\uB2C8\uB2E4. \uB8E8\uC2DC\uC5D8\uB9AC\uC758 \uACF5\uACA9 \uC2A4\uD0AC\uC740
      \uC801\uC5D0\uAC8C <color=#ff0000>\uBCC4\uC758 \uB9C8\uB825 \uD30C\uD3B8</color>\uC744
      3\uCD08 \uC0C8\uAE41\uB2C8\uB2E4. \uC774\uD6C4 <color=#ff0000>\uBCC4\uC758
      \uB9C8\uB825 \uD30C\uD3B8</color> \uD6A8\uACFC\uB294 \uB8E8\uC2DC\uC5D8\uB9AC\uC758
      \uB2E4\uC74C \uACF5\uACA9\uC5D0 \uB300\uD574 \uB450 \uAC00\uC9C0 \uD6A8\uACFC\uB97C
      \uC9C0\uB2D9\uB2C8\uB2E4.\n<color=#ff0000>\uBCC4\uC758 \uB9C8\uB825 \uD30C\uD3B8</color>\uC774
      \uC0C8\uACA8\uC9C4 \uC801\uC5D0\uAC8C \uAE30\uBCF8 \uACF5\uACA9 \uC801\uC911
      \uC2DC,\n\uC801\uC5D0\uAC8C \uAC00\uD574\uC9C4 \uBCC4\uC758 \uB9C8\uB825 \uD30C\uD3B8\uC744
      \uC81C\uAC70\uD558\uACE0, \uB8E8\uC2DC\uC5D8\uB9AC\uC758 2\uCD08 \uB0B4\uC758
      \uB2E4\uC74C \uAE30\uBCF8 \uACF5\uACA9 \uD639\uC740 \uAE30\uBCF8 \uACF5\uACA9
      \uC2A4\uD0AC\uC740 \uC81C\uAC70\uD55C \uBCC4\uC758 \uB9C8\uB825 \uD30C\uD3B8
      \uD558\uB098\uB2F9 4%, \uCD5C\uB300 20%\uC758 \uCD94\uAC00 \uD53C\uD574\uB97C
      \uAC00\uD569\uB2C8\uB2E4.\n<color=#ff0000>\uBCC4\uC758 \uB9C8\uB825 \uD30C\uD3B8</color>\uC774
      \uC0C8\uACA8\uC9C4 \uC801\uC5D0\uAC8C \uACF5\uACA9 \uC2A4\uD0AC \uC801\uC911
      \uC2DC\n\uC801\uC5D0\uAC8C \uAC00\uD574\uC9C4 \uBCC4\uC758 \uB9C8\uB825 \uD30C\uD3B8\uC744
      \uD3ED\uBC1C\uC2DC\uCF1C \uC8FC\uBCC0\uC5D0 <color=#c9ff99>\uBE5B \uC18D\uC131 
      <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uAE30\uBCF8
      \uACF5\uACA9 \uC704\uB825 : 80 INT</color>\n<color=#FFFF70>\uBCC4\uC758 \uB9C8\uB825
      \uB099\uC778 \uD3ED\uBC1C \uC704\uB825 : 30INT</color>"
  skills:
  - Icon: {fileID: -898488130, guid: f56a2e5c0b51d6f4b8a93f12a1b45b02, type: 3}
    skillCooltime: 0
    costKey: UltimatePoint
    cost: 250
    skillName: "\uCD08\uC2E0\uC131 \uD3ED\uBC1C"
    skillInfo: "\uBCC4\uC758 \uD798\uC744 \uAC15\uD558\uAC8C \uC555\uCD95\uD558\uC5EC
      \uAC15\uB825\uD55C \uD3ED\uBC1C\uC744 \uB9CC\uB4E4\uC5B4 \uB0C5\uB2C8\uB2E4.
      \uAE30\uB97C \uBAA8\uC73C\uB294 \uB3D9\uC548 <color=#004dff>\uBB34\uC801 \uC0C1\uD0DC</color>\uAC00
      \uB418\uBA70 \uC0DD\uC131\uB418\uB294 \uBCC4\uC740 \uC801\uC5D0\uAC8C \uC9C0\uC18D\uC801\uC73C\uB85C
      <color=#c9ff99>\uBE5B \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C
      \uC785\uD799\uB2C8\uB2E4. \uC774\uD6C4 \uCD08\uC2E0\uC131 \uD3ED\uBC1C\uC744
      \uC77C\uC73C\uCF1C \uAC15\uB825\uD55C <color=#c9ff99>\uBE5B \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95
      \uD53C\uD574</color></color>\uB97C \uC785\uD788\uACE0 \uC801\uC744 10\uCD08\uAC04
      <color=#ffc662>\uC2E4\uBA85</color>\uC2DC\uD0B5\uB2C8\uB2E4.\n<color=#FFFF70>\uC0DD\uC131\uB418\uB294
      \uBCC4\uC758 \uC704\uB825 : \uCD08\uB2F9 500 INT </color>\n<color=#FFFF70>\uCD08\uC2E0\uC131
      \uD3ED\uBC1C\uC758 \uC704\uB825 :  6500 INT</color>\n<color=#FF0055>\uAD81\uADF9\uAE30
      \uAC8C\uC774\uC9C0 250\uC744 \uCC44\uC6CC\uC57C \uBC1C\uB3D9\uD569\uB2C8\uB2E4</color>"
  - Icon: {fileID: -1965125912, guid: 8278790398948ba4daa2b49c8ca2cb8d, type: 3}
    skillCooltime: 3
    costKey: MP
    cost: 20
    skillName: "\uC9D1\uC911\uAD11\uC120"
    skillInfo: "0.5\uCD08 \uD6C4, \uC804\uBC29\uC5D0 \uAD11\uC120\uC744 \uB0B4\uB824\uCC0D\uC5B4
      \uC881\uC740 \uBC94\uC704\uC5D0 <color=#c9ff99>\uBE5B \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95
      \uD53C\uD574</color></color>\uB97C \uC785\uD799\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
      : 190 INT</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 4\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
      : \uB9C8\uB098 20</color>"
  - Icon: {fileID: -1548700323, guid: 8278790398948ba4daa2b49c8ca2cb8d, type: 3}
    skillCooltime: 15
    costKey: MP
    cost: 45
    skillName: "\uD50C\uB77C\uC988\uB9C8 \uBC29\uCD9C"
    skillInfo: "\uC790\uC2E0 \uC8FC\uBCC0\uC73C\uB85C \uD50C\uB77C\uC988\uB9C8\uB97C
      \uBC29\uCD9C\uD558\uC5EC <color=#eeee00>\uC804\uAE30 \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95
      \uD53C\uD574</color></color>\uB97C \uC785\uD78C \uD6C4, \uC790\uC2E0\uC758
      \uC704\uC5D0 \uD50C\uB77C\uC988\uB9C8 \uAD6C\uCCB4\uB97C 8\uCD08\uAC04 \uC0DD\uC131\uD569\uB2C8\uB2E4.
      \uD50C\uB77C\uC988\uB9C8 \uAD6C\uCCB4\uB294 \uC8FC\uAE30\uC801\uC73C\uB85C
      \uC8FC\uBCC0\uC5D0 <color=#eeee00>\uC804\uAE30 \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95
      \uD53C\uD574</color></color>\uB97C \uC785\uD799\uB2C8\uB2E4.\n<color=#FFFF70>\uBC29\uCD9C
      \uC704\uB825 : 70 INT</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 16\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
      : \uB9C8\uB098 45</color>"
  - Icon: {fileID: 1577460496, guid: 8278790398948ba4daa2b49c8ca2cb8d, type: 3}
    skillCooltime: 15
    costKey: MP
    cost: 45
    skillName: "\uC704\uC131\uBCF4\uD638"
    skillInfo: "\uC704\uC131 \uBCF4\uD638\uB97C \uC2DC\uC804\uD558\uC5EC 7\uCD08
      <color=#00ffff>\uBCF4\uD638\uB9C9\uC744 \uC0DD\uC131\uD558\uACE0 </color>\uC790\uC2E0
      \uC8FC\uBCC0\uC744 \uB3C4\uB294 \uAD6C\uCCB4\uB97C \uC0DD\uC131\uD569\uB2C8\uB2E4.
      \uC774 \uAD6C\uCCB4\uB294 \uC801\uC744 <color=#ffA70D>\uBC00\uCCD0 \uB0C5\uB2C8\uB2E4</color>.
      \n<color=#FFFF70>\uBCF4\uD638\uB9C9\uC758 \uC591 : 10%MaxHP</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
      : 15\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 45</color>"
  - Icon: {fileID: -1312941429, guid: 8278790398948ba4daa2b49c8ca2cb8d, type: 3}
    skillCooltime: 7
    costKey: MP
    cost: 25
    skillName: "\uBCC4\uBE5B\uC758 \uC778\uB3C4"
    skillInfo: "\uBCC4\uBE5B\uC744 \uC0DD\uC131\uD558\uC5EC \uC785\uB825\uD55C \uBC29\uD5A5\uC73C
      \uBCC4\uBE5B\uACFC \uAC19\uC774 \uC774\uB3D9\uD569\uB2C8\uB2E4. \uBCC4\uBE5B\uC5D0
      \uAC10\uC2F8\uC838 \uC788\uB294 \uB3D9\uC548 <color=#00abff>\uBCF4\uD638</color>
      \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4. \uB610\uD55C \uC9C0\uB098\uAC00\uB294
      \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uBCC4\uC758 \uD30C\uD3B8 \uB099\uC778\uC744
      \uC0C8\uAE41\uB2C8\uB2E4.\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 7\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
      : \uB9C8\uB098 25</color>"
  - Icon: {fileID: 1626001005, guid: 8278790398948ba4daa2b49c8ca2cb8d, type: 3}
    skillCooltime: 11
    costKey: MP
    cost: 45
    skillName: "\uB300\uC801\uC758 \uD3ED\uD48D"
    skillInfo: "\uC790\uC2E0 \uC8FC\uBCC0\uC73C\uB85C \uBD89\uC740 \uD3ED\uD48D\uC744
      3\uCD08\uAC04 \uB450\uB985\uB2C8\uB2E4. \uBD89\uC740 \uD3ED\uD48D\uC740 \uC77C\uC815
      \uAC70\uB9AC\uC758 \uC801\uC5D0\uAC8C \uC8FC\uAE30\uC801\uC73C\uB85C <color=#70e6f3>\uBC14\uB78C
      \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C
      \uC785\uD799\uB2C8\uB2E4.\n<color=#FFFF70>\uD3ED\uD48D\uC758 \uC704\uB825 :
      \uCD08\uB2F9 130INT</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 9\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
      : \uB9C8\uB098 40</color>"
  - Icon: {fileID: -1444178440, guid: 8278790398948ba4daa2b49c8ca2cb8d, type: 3}
    skillCooltime: 8
    costKey: MP
    cost: 20
    skillName: "\uAD11\uC790 \uB3C4\uC57D"
    skillInfo: "\uC804\uBC29\uC73C\uB85C \uC21C\uAC04\uC774\uB3D9\uD558\uBA70 \uC8FC\uBCC0\uC5D0
