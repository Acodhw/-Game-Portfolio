  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd61d093056a244429e6e0f9b08a651c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterCode: 3
  characterName: "\uB8E8\uC774\uC820"
  characterInfo: "\uD0DC\uC591\uC758 \uD798\uC744 \uD488\uACE0 \uC788\uB294 \uCC3D\uC744
    \uB2E4\uB8E8\uB294 \uD0DC\uC591\uC758 \uC804\uC0AC\uB2E4. \uC790\uC2E0\uC758
    \uB2A5\uB825\uC744 \uC758\uC2EC\uD588\uACE0 \uC790\uC2E0\uC774 \uC5B8\uC81C\uB098
    \uC57D\uD558\uB2E4\uACE0 \uC5EC\uACBC\uC9C0\uB9CC, \uC790\uC2E0\uC758 \uAC00\uCE58\uB97C
    \uAE68\uB2EB\uACE0 \uD0DC\uC591\uC758 \uD798\uC744 \uAC01\uC131\uD558\uC600\uB2E4.
    \uC774 \uD798\uC744 \uB354 \uB2E8\uB828\uD558\uACE0\uC790 \uB178\uB825\uD558\uACE0
    \uC788\uB2E4.\n\n\uBB34\uAE30 : \uD0DC\uC591\uC758 \uCC3D\n\uD0DC\uC591\uC758
    \uC2E0\uC5D0\uAC8C \uC120\uD0DD\uBC1B\uC740 \uC790\uB9CC\uC774 \uADF8 \uD798\uC744
    \uC81C\uB300\uB85C \uB2E4\uB8F0 \uC218 \uC788\uB2E4\uACE0 \uC804\uD574\uC9C0\uB294
    \uCC3D\uC785\uB2C8\uB2E4."
  passiveOn: 1
  passive:
    Icon: {fileID: -629545260, guid: e61aa29d1f082b4469625103dea48216, type: 3}
    Name: "\uD0DC\uC591\uCC3D\uC758 \uD798"
    Info: "\uAE30\uBCF8 \uACF5\uACA9 \uBC0F \uACF5\uACA9 \uC2A4\uD0AC\uC774 \uC801\uC5D0\uAC8C
      \uC801\uC911\uD560 \uC2DC, \uD0DC\uC591\uCC3D\uC774 \uD798\uC744 \uBAA8\uC73C\uAE30
      \uC2DC\uC791\uD569\uB2C8\uB2E4. 0.75\uCD08 \uB0B4\uB85C \uB2E4\uC74C \uACF5\uACA9
      \uC2A4\uD0AC \uC801\uC911 \uD6C4 \uAE30\uBCF8 \uACF5\uACA9 \uBC0F \uACF5\uACA9
      \uC2A4\uD0AC\uC744 \uC801\uC911\uC2DC\uD0A4\uBA74 \uD0DC\uC591\uCC3D\uC740
      \uD798\uC744 \uD55C\uBC88 \uB354 \uBAA8\uC73C\uBA70, \uCD1D 5\uBC88 \uD798\uC774
      \uC313\uC778 \uD6C4 0.75\uCD08 \uB0B4\uB85C \uD55C\uBC88 \uB354 \uD798\uC744
      \uBAA8\uC744 \uC2DC \uD798\uC744 \uBC29\uCD9C\uD558\uC5EC \uC8FC\uBCC0\uC5D0
      \uAC15\uB825\uD55C <color=#c9ff99>\uBE5B \uC18D\uC131<color=#ff98EF> \uB9C8\uBC95
      \uD53C\uD574</color></color>\uB97C \uAC00\uD569\uB2C8\uB2E4. \uB610\uD55C \uACF5\uACA9
      \uC2A4\uD0AC\uC744 \uC2DC\uC804 \uBC0F \uC7AC\uC2DC\uC804\uD560 \uC2DC \uC8FC\uBCC0\uC5D0
      \uCC3D\uC774 \uBAA8\uC740 \uD798\uC5D0 \uBE44\uB840\uD55C <color=#c9ff99>\uBE5B
      \uC18D\uC131<color=#ff98EF> \uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C
      \uAC00\uD569\uB2C8\uB2E4.\n\uC774 \uD6A8\uACFC\uB85C \uC785\uD78C \uD53C\uD574\uB85C\uB294
      \uCC3D\uC774 \uD798\uC744 \uCD95\uC801\uD558\uAC70\uB098 \uBC29\uCD9C\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.\n\uD798\uC744 \uCD95\uC801\uD55C \uC0C1\uD0DC\uC5D0\uC11C
      \uC5F0\uC18D\uB41C \uAE30\uBCF8 \uACF5\uACA9\uC73C\uB85C\uB294 \uD798\uC774
      \uC313\uC774\uC9C0 \uC54A\uC9C0\uB9CC, \uC9C0\uC18D \uC2DC\uAC04\uC774 \uAC31\uC2E0\uB429\uB2C8\uB2E4.\n<color=#FFFF70>\uBC29\uCD9C
      \uC704\uB825 : 300 INT(+300 ATK) </color>\n<color=#FFFF70>\uC2A4\uD0AC \uC0AC\uC6A9
      \uC2DC \uB9C8\uBC95 \uD53C\uD574 \uC704\uB825 : 25 INT x (\uCC3D\uC774 \uBAA8\uC740
      \uD798+1)</color>"
  skills:
  - Icon: {fileID: -1913807883, guid: f56a2e5c0b51d6f4b8a93f12a1b45b02, type: 3}
    skillCooltime: 0
    costKey: UltimatePoint
    cost: 250
    skillName: "\uD0DC\uC591 \uAC01\uC131"
    skillInfo: "\uD0DC\uC591\uC758 \uC804\uC0AC\uC758 \uD798\uC744 \uAC01\uC131\uC2DC\uD0B5\uB2C8\uB2E4.
      \uC790\uC2E0 \uC8FC\uBCC0\uC5D0 \uC788\uB294 \uBAA8\uB4E0 \uD22C\uC0AC\uCCB4\uB97C
      \uC81C\uAC70\uD55C \uB4A4, \uC8FC\uBCC0\uC5D0 \uAC15\uB825\uD55C <color=#c9ff99>\uBE5B
      \uC18D\uC131</color><color=#ff98ef> \uB9C8\uBC95 \uD53C\uD574</color>\uB97C
      \uAC00\uD569\uB2C8\uB2E4. \uC774\uD6C4 10\uCD08\uAC04 \uBAA8\uB4E0 \uAE30\uBCF8
      \uACF5\uACA9 \uBC0F \uACF5\uACA9 \uC2A4\uD0AC\uC774 \uC801\uC5D0\uAC8C <color=#ff0000>\uD0DC\uC591\uC758
      \uAC01\uC778</color>\uC744 \uB0A8\uAE41\uB2C8\uB2E4. <color=#ff0000>\uD0DC\uC591\uC758
      \uAC01\uC778</color>\uC774 \uB0A8\uC740 \uC801\uC5D0\uAC8C \uC790\uC2E0\uC774
      \uC8FC\uB294  \uAE30\uBCF8 \uACF5\uACA9 \uBC0F \uACF5\uACA9 \uC2A4\uD0AC\uACFC
      \uD328\uC2DC\uBE0C\uC758 \uBB3C\uB9AC \uBC0F \uB9C8\uBC95 \uD53C\uD574\uAC00
      110%\uC99D\uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825 3000 INT(+3000
      ATK)</color>\n<color=#FF0055>\uAD81\uADF9\uAE30 \uAC8C\uC774\uC9C0 250\uC744
      \uCC44\uC6CC\uC57C \uBC1C\uB3D9\uD569\uB2C8\uB2E4</color>"
  - Icon: {fileID: 2127079937, guid: e3787e7eb7e4325488231dcefb85b5ad, type: 3}
    skillCooltime: 6
    costKey: MP
    cost: 30
    skillName: "\uD0DC\uC591\uCC3D \uCC0C\uB974\uAE30"
    skillInfo: "\uC804\uBC29\uC73C\uB85C \uB3CC\uC9C4\uD558\uBA70 \uC804\uBC29\uC758
      \uC801\uC744 <color=#ffa70d>\uBC00\uCCD0\uB0B4\uACE0</color> <color=#ffffb7>\uBB34\uC18D\uC131
      \uBB3C\uB9AC \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n\uB3CC\uC9C4\uC774
      \uB05D\uB098\uB294 \uC21C\uAC04\uC5D0 \uC7AC\uC2DC\uC804 \uC2DC :\n\uC804\uBC29\uC758
      \uC801\uC744 <color=#ffc662>\uACF5\uC911\uC73C\uB85C \uB744\uC6B0\uACE0</color>
      <color=#ffffb7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
