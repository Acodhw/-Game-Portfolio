    value:
    - stringlist:
      - "\uC2AC\uB798\uC26C"
      - "\uC9C0\uC815\uD55C \uBC29\uD5A5\uC73C\uB85C \uB3CC\uC9C4\uD558\uBA70 \uC57D\uAC04\uC758
        <color=#FFFFB7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
        \uC785\uD799\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825 : 15</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
        : 10\uCD08</color>"
      - "\uD50C\uB798\uC26C"
      - "\uC9C0\uC815\uD55C \uBC29\uD5A5\uC73C\uB85C \uC9E7\uC740 \uAC70\uB9AC \uC21C\uAC04\uC774\uB3D9
        \uD569\uB2C8\uB2E4.\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 20\uCD08</color>"
      - "\uCE90\uB17C"
      - "\uC9C0\uC815\uD55C \uAC70\uB9AC\uB85C \uCD5C\uB300 \uBB34\uD55C\uB300\uC758
        \uAC70\uB9AC\uB97C \uB0A0\uC544\uAC11\uB2C8\uB2E4. \uC790\uB825\uC73C\uB85C
        \uBE44\uD589 \uD574\uC81C\uD560 \uC218 \uC5C6\uC73C\uBA70 \uBCBD\uC5D0 \uB2FF\uAC70\uB098
        \uC801\uC758 \uAD70\uC911\uC81C\uC5B4\uAE30\uC5D0 \uB9DE\uC744 \uACBD\uC6B0
        \uD480\uB824\uB0A9\uB2C8\uB2E4. \uBE44\uD589\uD558\uB294 \uB3D9\uC548 \uB2FF\uC740
        \uC801\uC5D0\uAC8C\uB294 \uAC15\uD55C  <color=#FFFFB7>\uBB34\uC18D\uC131
        \uBB3C\uB9AC \uD53C\uD574</color>\uB97C \uC785\uD799\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
        : 110</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 25\uCD08</color>"
      - "\uD50C\uB77C\uC774"
      - "3\uCD08\uAC04 \uC790\uC2E0\uC758 \uC911\uB825\uC744 \uC5C6\uC560\uC9C0\uB9CC
        \uC790\uB825\uC73C\uB85C \uC704\uC544\uB798\uB85C \uC6C0\uC9C1\uC77C \uC218
        \uC5C6\uACE0 \uC774\uB3D9 \uAD00\uB828 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD560
        \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 15\uCD08</color>"
      - "\uD0C0\uAE43"
      - "\uC77C\uC815 \uBC94\uC704 \uB0B4\uC758 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC744
        \uD0C0\uAE43\uC73C\uB85C \uC0BC\uC544 \uADF8 \uC704\uCE58\uB85C \uC21C\uAC04\uC774\uB3D9\uD569\uB2C8\uB2E4.\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
        : 15\uCD08</color>"
      - "\uC800\uC9C0 \uBD88\uAC00"
      - "1.5\uCD08\uAC04 \uC790\uC2E0\uC5D0\uAC8C \uAC78\uB9B0 <color=#ffc662>\uBAA8\uB4E0
        \uAD70\uC911 \uC81C\uC5B4 \uD6A8\uACFC</color>\uB97C \uC81C\uAC70\uD558\uACE0
        <color=#00abff>\uC800\uC9C0 \uBD88\uAC00</color> \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4.\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
        : 20\uCD08</color>"
    - stringlist:
      - "\uACFC\uB2E4\uCE58\uC720"
      - "\uC790\uC2E0\uC774 \uBC1B\uB294 \uCE58\uB8CC \uD6A8\uACFC\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
      - "\uBCF4\uD638"
      - "\uAD70\uC911\uC81C\uC5B4 \uD6A8\uACFC\uC640 \uB370\uBBF8\uC9C0\uB97C \uBC1B\uC9C0
        \uC54A\uB294 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
      - "\uBB34\uC801"
      - "\uBAA8\uB4E0 \uB370\uBBF8\uC9C0 \uD6A8\uACFC\uC5D0 \uBA74\uC5ED\uC774 \uB429\uB2C8\uB2E4."
      - "\uC800\uC9C0 \uBD88\uAC00"
      - "\uBAA8\uB4E0 \uAD70\uC911\uC81C\uC5B4 \uD6A8\uACFC\uC5D0 \uBA74\uC5ED\uC774
        \uB429\uB2C8\uB2E4."
      - "\uBD88\uCE58"
      - "\uC790\uC2E0\uC774 \uBC1B\uB294 \uCE58\uB8CC \uD6A8\uACFC\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
    - stringlist:
      - 
      - "\uBA38\uB9AC\uC18D\uC5D0 \uC6B8\uB824 \uD37C\uC9C4 \uBAA9\uC18C\uB9AC\uB97C
        \uB4E3\uACE0 \uAE30\uC5B5\uC744 \uC783\uC740 \uCC44\uB85C \uAE68\uC5B4\uB0AC\uB2E4.
        \uBAA9\uC18C\uB9AC\uC758 \uBE44\uBC00\uACFC \uC790\uAE30 \uC790\uC2E0\uC5D0
        \uB300\uD574 \uC54C\uAE30 \uC704\uD574 \uAE30\uC5B5\uC744 \uCC3E\uAE30 \uC704\uD55C
        \uC5EC\uC815\uC744 \uB5A0\uB09C\uB2E4. "
      - "\uAE30\uC5B5\uC758 \uAC80\uC220"
      - "\uBAB8\uC774 \uAE30\uC5B5\uD558\uB294 \uAC80\uC220\uC785\uB2C8\uB2E4.\n\uBAA8\uB4E0
        \uAE30\uBCF8 \uACF5\uACA9\uC5D0 <color=#FFA70D>\uBC00\uCE58\uAE30</color>\uAC00
        \uC801\uC6A9\uB418\uBA70, \uC5F0\uC18D\uB41C \uC138 \uBC88\uC9F8 \uAE30\uBCF8
        \uACF5\uACA9 \uBAA8\uC158\uC774 \uCD94\uAC00  <color=#FFFFB7>\uBB34\uC18D\uC131
        \uBB3C\uB9AC \uD53C\uD574</color>\uC640 \uB354 \uAC15\uD55C <color=#FFA70D>\uBC00\uCE58\uAE30</color>\uB97C
        \uC801\uC6A9\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC138 \uBC88\uC9F8 \uAE30\uBCF8
        \uACF5\uACA9 \uC704\uB825 : 150</color>"
      - "\uAD81\uADF9\uC758 \uAC80"
      - "\uC790\uC2E0\uC758 \uD798\uC744 \uAC80\uACFC \uB3D9\uAE30\uD654\uD558\uC5EC
        \uAE30\uC6B4\uC744 \uBFDC\uC5B4\uB0B4\uB294 \uAC15\uB825\uD55C \uAE30\uC220\uC785\uB2C8\uB2E4.
        \uAE30\uC6B4\uC744 \uBAA8\uC740 \uD6C4 \uB6F0\uC5B4 \uC62C\uB77C <color=#004dff>\uBB34\uC801</color>\uC0C1\uD0DC\uAC00
        \uB418\uBA70 \uB113\uC740 \uBC94\uC704\uC5D0 \uAC70\uB300\uD55C \uAC80\uAE30\uB97C
        \uD718\uB450\uB985\uB2C8\uB2E4. \uAC80\uAE30\uC5D0 \uB9DE\uC740 \uC801\uC740
        \uAC15\uD55C<color=#FFFFB7> \uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
        \uC785\uD788\uACE0 <color=#ffa70d>\uAE30\uC808</color>\uC2DC\uD0B5\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
        1500</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 25\uCD08</color>\n<color=#FF0055>\uAD81\uADF9\uAE30
        \uAC8C\uC774\uC9C0 100\uC744 \uCC44\uC6CC\uC57C \uBC1C\uB3D9\uD569\uB2C8\uB2E4</color>"
      - "\uC774\uC5F0\uACA9"
      - "2\uBC88 \uBE60\uB974\uAC8C \uAC80\uC744 \uD718\uB458\uB7EC \uAC01\uAC01\uC758
        \uAC80\uACA9\uB9C8\uB2E4 <color=#FFFFB7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
        \uC785\uD799\uB2C8\uB2E4. \uCE58\uBA85\uD0C0\uAC00 \uC801\uC6A9\uB418\uBA70
        \uC774\uC5F0\uACA9\uC758 \uACF5\uACA9\uC740 \uAE30\uBCF8 \uACF5\uACA9 \uAC15\uD654
        \uC2A4\uD0AC \uD6A8\uACFC\uB97C \uC801\uC6A9\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uAC01
        \uAC80\uACA9 \uD53C\uD574 \uC704\uB825 : 75</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
        : 3\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 10</color>"
      - "\uAC80\uC220 \uD0DC\uC138"
      - "\uAC80\uC220 \uD0DC\uC138\uB97C \uBC14\uB85C\uC7A1\uC544 \uAE30\uBCF8 \uACF5\uACA9\uC744
        \uAC15\uD654\uD569\uB2C8\uB2E4. 10\uCD08 \uC774\uB0B4\uC758 \uB2E4\uC74C
        \uC138 \uBC88\uC758 \uAE30\uBCF8 \uACF5\uACA9\uC774 <color=#ff98ef>\uBB34\uC18D\uC131
        \uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uAC00\uD558\uB294 \uAC80\uAE30\uB97C
        \uBC1C\uC0AC\uD569\uB2C8\uB2E4. \uC2DC\uC804 \uC2DC \uB2E4\uB978 \uAE30\uBCF8
        \uACF5\uACA9 \uAC15\uD654 \uC2A4\uD0AC \uD6A8\uACFC\uB97C \uB300\uCCB4\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uAC80\uAE30\uC758
        \uC704\uB825 : 50</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 11\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
        : \uB9C8\uB098 25</color>"
      - "\uD68C\uC804\uACF5\uACA9"
      - "\uD55C \uBC14\uD034 \uB3CC\uC544 \uAC80\uC744 \uBCA0\uBA74\uC11C \uC8FC\uBCC0\uC5D0
        <color=#ffffb7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
        \uAC00\uD558\uACE0 <color=#ffc662>\uB454\uD654</color>\uC2DC\uD0B5\uB2C8\uB2E4.
        \uACF5\uC911\uC5D0\uC11C\uB294 \uB5A8\uC5B4\uC9C8 \uB54C \uC4F0\uBA74 \uCCB4\uACF5\uC2DC\uAC04\uC744
        \uB298\uB824\uC90D\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825 : 125</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
        : 4\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 15</color>"
      - "\uC62C\uB824\uCE58\uAE30"
      - "\uC804\uBC29\uC758 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C <color=#ffffb7>\uBB34\uC18D\uC131
        \uBB3C\uB9AC \uD53C\uD574</color>\uB97C \uAC00\uD558\uACE0 <color=#ffc662>\uACF5\uC911\uC5D0
        \uB744\uC6C1\uB2C8\uB2E4</color>.\n<color=#FFFF70>\uC704\uB825 : 150</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
        : 7\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 15</color>"
      - "\uAC80\uAE30\uB3C4\uC57D"
      - "\uC804\uBC29\uC73C\uB85C \uAC00\uC18D\uD558\uC5EC \uBE60\uB974\uAC8C \uB3C4\uC57D\uD558\uBA74\uC11C
        \uAE30\uC6B4\uC744 \uBAA8\uC74D\uB2C8\uB2E4. \uADF8 \uC774\uD6C4 <color=#ff98ef>\uBB34\uC18D\uC131
        \uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uC785\uD788\uB294 \uAC80\uAE30\uB97C
        \uBC1C\uC0AC\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825 : 100(+10 ATK)</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
        : 9\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 20</color>"
      - "\uC808\uB300\uC801 \uACF5\uACA9"
      - "\uC790\uC2E0\uC758 \uD1B5\uCC30\uB825\uC744 \uD0A4\uC6CC\uC11C \uAE09\uC18C\uB97C
        \uB9DE\uCD94\uAC8C \uD569\uB2C8\uB2E4. 10\uCD08 \uC774\uB0B4\uC758 \uB2E4\uC74C
        2\uBC88\uC758 \uAE30\uBCF8 \uACF5\uACA9\uC774 \uAC15\uD654\uB418\uC5B4 \uCD94\uAC00
        <color=#78a6a6>\uACE0\uC815 \uD53C\uD574</color>\uB97C \uC785\uD799\uB2C8\uB2E4.
        \uC2DC\uC804 \uC2DC \uB2E4\uB978 \uAE30\uBCF8 \uACF5\uACA9 \uAC15\uD654 \uC2A4\uD0AC
        \uD6A8\uACFC\uB97C \uB300\uCCB4\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
        : 100</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 15\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
        : \uB9C8\uB098 30</color>"
      - "\uD68C\uC624\uB9AC\uCC38\uACA9"
      - "\uACF5\uC911\uC73C\uB85C \uB6F0\uC5B4\uC62C\uB77C \uCD1D 3\uBC88 \uAC80\uC744
        \uD718\uB458\uB7EC <color=#ffffb7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
        \uC785\uD788\uACE0 <color=#ffc662>\uACF5\uC911\uC73C\uB85C \uB744\uC6C1\uB2C8\uB2E4</color>.\n<color=#FFFF70>\uAC01
        \uD0C0\uACA9\uB2F9 : 80</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 14\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
        : \uB9C8\uB098 35</color>"
      - "\uBD89\uC740 \uCDA4"
      - "\uB5A0\uC62C\uB824\uB0B8 \uBD88\uC758 \uC815\uB839\uC758 \uCDA4\uC785\uB2C8\uB2E4.
        \uBD89\uC740 \uCDA4\uC744 \uCD94\uBA70 \uBD88\uC758 \uD798\uC744 \uCDA9\uC804\uD558\uACE0
        \uAC80\uC744 \uB0B4\uB824\uCC0D\uC73C\uBA70 \uC8FC\uBCC0\uC5D0 \uBD88\uAE38\uC744
        \uC0DD\uC131\uD574 \uAC15\uB825\uD55C <color=#ff661a>\uBD88 \uC18D\uC131<color=#ff98ef>
        \uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C \uC785\uD799\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
        : 200(+ 150 ATK)</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 11\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
        : \uB9C8\uB098 25</color>"
      - "\uB1CC\uC804\uAC80"
      - "\uC804\uACA9\uC758 \uB9C8\uB825\uC744 \uBD88\uC5B4\uB123\uC5B4 \uC790\uC2E0\uC5D0\uAC8C
        \uC804\uAE30\uB97C \uC0DD\uC131\uD558\uC5EC \uC7A0\uC2DC <color=#ffc668>\uB454\uD654</color>\uB418\uBA70,
        \uC8FC\uBCC0\uC5D0 <color=#eeee00>\uC804\uAE30 \uC18D\uC131</color><color=#ff98ef>
        \uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4. \uC774\uD6C4
        \uAC80\uC5D0 \uB1CC\uC804\uC774 \uB0A8\uC544 10\uCD08 \uB0B4\uC758 \uB2E4\uC74C
        \uC138\uBC88\uC758 \uAE30\uBCF8 \uACF5\uACA9\uC774 \uCD94\uAC00 <color=#eeee00>\uC804\uAE30
        \uC18D\uC131</color><color=#ffffb7> \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
        \uAC00\uD569\uB2C8\uB2E4. \uC2DC\uC804 \uC2DC \uB2E4\uB978 \uAE30\uBCF8 \uACF5\uACA9
        \uAC15\uD654 \uC2A4\uD0AC \uD6A8\uACFC\uB97C \uB300\uCCB4\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC804\uAE30
        \uBC29\uCD9C\uC758 \uC704\uB825 : 75\n\uAE30\uBCF8 \uACF5\uACA9 \uAC15\uD654
        \uC704\uB825 : 50</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 14</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
        : \uB9C8\uB098 30</color>"
      - "\uCE74\uC6B4\uD130"
      - "\uC7A0\uC2DC <color=#004dff>\uBCF4\uD638</color> \uC0C1\uD0DC\uAC00 \uB429\uB2C8\uB2E4.
        \uADF8 \uC0C1\uD0DC\uC5D0\uC11C \uC801\uC73C\uB85C\uBD80\uD130 \uACF5\uACA9\uC744
        \uBC1B\uC744 \uC2DC \uC804\uBC29\uC5D0 \uAC15\uB825\uD55C <color=#78a6a6>\uBB34\uC18D\uC131
        \uBB3C\uB9AC \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
        : 350</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 20\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
        : \uB9C8\uB098 25</color>"
      - "\uD3ED\uD48D\uB09C\uACA9"
      - "\uAC80\uC744 \uD3ED\uD48D\uCC98\uB7FC \uBAB0\uC544\uCCD0 \uADF8 \uC790\uB9AC\uC5D0\uC11C
        \uC815\uC2E0\uC744 \uC9D1\uC911\uD558\uC5EC <color=#70e6f3>\uBC14\uB78C \uC18D\uC131</color><color=#ffffb7>
        \uBB3C\uB9AC \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4. \uC2DC\uC804
        1\uCD08 \uD6C4 \uC6C0\uC9C1\uC5EC\uC11C \uD574\uC81C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n<color=#FFFF70>\uCD08\uB2F9
        \uC704\uB825 : 120</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 9\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
