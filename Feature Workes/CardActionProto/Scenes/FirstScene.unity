  - Icon: {fileID: 1621206565, guid: e3787e7eb7e4325488231dcefb85b5ad, type: 3}
    skillCooltime: 16
    costKey: MP
    cost: 40
    skillName: "\uC11D\uC591"
    skillInfo: "\uC804\uBC29\uC744 \uD5A5\uD574 \uB5A8\uC5B4\uC9C0\uB294 \uBE5B\uC758
      \uCC3D\uC744 \uC0DD\uC131\uD569\uB2C8\uB2E4. \uCC3D\uC740 \uB2FF\uB294 \uBAA8\uB4E0
      \uC801\uC5D0\uAC8C <color=#c9ff99>\uBE5B \uC18D\uC131</color> <color=#ff98ef>\uB9C8\uBC95
      \uD53C\uD574</color>\uB97C \uC785\uD799\uB2C8\uB2E4. \uB610\uD55C \uBCBD\uACFC
      \uBC14\uB2E5\uC744 \uAD00\uD1B5\uD569\uB2C8\uB2E4. \n\uC2DC\uC804 \uD6C4 1.75\uCD08
      \uC548\uC5D0 \uCC3D\uC774 \uC801\uC744 \uCC98\uC74C \uAC00\uACA9\uD55C \uC21C\uAC04\uC5D0
      \uC7AC\uC2DC\uC804 \uC2DC :\n\uCC98\uC74C \uAC00\uACA9\uD55C \uC801\uC774 \uC788\uB294
      \uC704\uCE58\uB85C \uC21C\uAC04\uC774\uB3D9\uD558\uC5EC \uC8FC\uBCC0\uC758
      \uC801\uC5D0\uAC8C <color=#ffffb7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
      \uAC00\uD558\uACE0 <color=#ffc662>\uB454\uD654</color>\uC2DC\uD0B5\uB2C8\uB2E4.\n<color=#FFFF70><i>\uC2DC\uC804
      \uD6C4 1.75\uCD08\uAC00 \uC9C0\uB098\uACE0 \uCC3D\uC774 \uC801\uC5D0\uAC8C
      \uB2FF\uC9C0 \uC54A\uC558\uC744 \uACBD\uC6B0 \uB9C8\uB098\uC758 75%\uB97C \uBC18\uD658\uD558\uACE0
      \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774 0\uCD08\uB85C \uC801\uC6A9\uB429\uB2C8\uB2E4.
      \uC774 \uC2A4\uD0AC\uC758 \uC7AC\uC2DC\uC804\uC740 \uAD70\uC911\uC81C\uC5B4\uAE30\uC5D0
      \uAC78\uB838\uAC70\uB098 \uB2E4\uB978 \uC2A4\uD0AC \uC0AC\uC6A9 \uB3C4\uC911\uC5D0\uB3C4
      \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</i></color>\n<color=#FFFF70>\uB5A8\uC5B4\uC9C0\uB294
