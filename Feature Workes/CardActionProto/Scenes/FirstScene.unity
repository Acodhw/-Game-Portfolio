  m_Script: {fileID: 11500000, guid: 895d57942b634cd4881ccb4c54380757, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterCode: 0
  characterName: 
  characterInfo: "\uBA38\uB9AC\uC18D\uC5D0 \uC6B8\uB824 \uD37C\uC9C4 \uBAA9\uC18C\uB9AC\uB97C
    \uB4E3\uACE0 \uAE30\uC5B5\uC744 \uC783\uC740 \uCC44\uB85C \uAE68\uC5B4\uB0AC\uB2E4.
    \uBAA9\uC18C\uB9AC\uC758 \uBE44\uBC00\uACFC \uC790\uAE30 \uC790\uC2E0\uC5D0 \uB300\uD574
    \uC54C\uAE30 \uC704\uD574 \uAE30\uC5B5\uC744 \uCC3E\uAE30 \uC704\uD55C \uC5EC\uC815\uC744
    \uB5A0\uB09C\uB2E4. \n\n\uBB34\uAE30 : \uBC84\uB824\uC9C4 \uAC80\n\uC775\uC219\uD55C
    \uAC80\uC785\uB2C8\uB2E4. \uC774\uC804\uC5D0 \uAC80\uC744 \uB2E4\uB8EC \uB4EF,
    \uD55C\uBAB8\uCC98\uB7FC \uB290\uAEF4\uC9D1\uB2C8\uB2E4."
  passiveOn: 1
  passive:
    Icon: {fileID: -1970717062, guid: e61aa29d1f082b4469625103dea48216, type: 3}
    Name: "\uAE30\uC5B5\uC758 \uAC80\uC220"
    Info: "\uBAB8\uC774 \uAE30\uC5B5\uD558\uB294 \uAC80\uC220\uC785\uB2C8\uB2E4.\n\uBAA8\uB4E0
      \uAE30\uBCF8 \uACF5\uACA9\uC5D0 <color=#FFA70D>\uBC00\uCE58\uAE30</color>\uAC00
      \uC801\uC6A9\uB418\uBA70, \uC5F0\uC18D\uB41C \uC138 \uBC88\uC9F8 \uAE30\uBCF8
      \uACF5\uACA9 \uBAA8\uC158\uC774 \uCD94\uAC00  <color=#FFFFB7>\uBB34\uC18D\uC131
      \uBB3C\uB9AC \uD53C\uD574</color>\uC640 \uB354 \uAC15\uD55C <color=#FFA70D>\uBC00\uCE58\uAE30</color>\uB97C
      \uC801\uC6A9\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC138 \uBC88\uC9F8 \uAE30\uBCF8
      \uACF5\uACA9 \uC704\uB825 :  150%\uC758 \uACF5\uACA9 \uD53C\uD574</color>"
  skills:
  - Icon: {fileID: 1987506508, guid: f56a2e5c0b51d6f4b8a93f12a1b45b02, type: 3}
    skillCooltime: 0
    costKey: UltimatePoint
    cost: 250
    skillName: "\uAD81\uADF9\uC758 \uAC80"
    skillInfo: "\uC790\uC2E0\uC758 \uD798\uC744 \uAC80\uACFC \uB3D9\uAE30\uD654\uD558\uC5EC
      \uAE30\uC6B4\uC744 \uBFDC\uC5B4\uB0B4\uB294 \uAC15\uB825\uD55C \uAE30\uC220\uC785\uB2C8\uB2E4.
      \uAE30\uC6B4\uC744 \uBAA8\uC740 \uD6C4 \uB6F0\uC5B4 \uC62C\uB77C <color=#004dff>\uBB34\uC801</color>\uC0C1\uD0DC\uAC00
      \uB418\uBA70 \uB113\uC740 \uBC94\uC704\uC5D0 \uAC70\uB300\uD55C \uAC80\uAE30\uB97C
      \uD718\uB450\uB985\uB2C8\uB2E4. \uAC80\uAE30\uC5D0 \uB9DE\uC740 \uC801\uC740
      \uAC15\uD55C<color=#FFFFB7> \uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
      \uC785\uD788\uACE0 5\uCD08\uAC04 <color=#ffa70d>\uAE30\uC808</color>\uC2DC\uD0B5\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825
      :  8500 ATK</color>\n<color=#FF0055>\uAD81\uADF9\uAE30 \uAC8C\uC774\uC9C0 250\uC744
      \uCC44\uC6CC\uC57C \uBC1C\uB3D9\uD569\uB2C8\uB2E4</color>"
  - Icon: {fileID: -824628038, guid: 3ae2edcc9fa761f42a495df1f0f62a29, type: 3}
    skillCooltime: 3
    costKey: MP
    cost: 10
    skillName: "\uC774\uC5F0\uACA9"
    skillInfo: "2\uBC88 \uBE60\uB974\uAC8C \uAC80\uC744 \uD718\uB458\uB7EC \uAC01\uAC01\uC758
      \uAC80\uACA9\uB9C8\uB2E4 <color=#FFFFB7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C
      \uC785\uD799\uB2C8\uB2E4. \uCE58\uBA85\uD0C0\uAC00 \uC801\uC6A9\uB418\uBA70
      \uC774\uC5F0\uACA9\uC758 \uACF5\uACA9\uC740 \uAE30\uBCF8 \uACF5\uACA9 \uAC15\uD654
      \uC2A4\uD0AC \uD6A8\uACFC\uB97C \uC801\uC6A9\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uAC01
      \uAC80\uACA9 \uD53C\uD574 \uC704\uB825 : 75%\uC758 \uACF5\uACA9 \uD53C\uD574</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
      : 3\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 10</color>"
  - Icon: {fileID: -797441231, guid: 3ae2edcc9fa761f42a495df1f0f62a29, type: 3}
    skillCooltime: 11
    costKey: MP
    cost: 25
    skillName: "\uAC80\uC220 \uD0DC\uC138"
    skillInfo: "\uAC80\uC220 \uD0DC\uC138\uB97C \uBC14\uB85C\uC7A1\uC544 \uAE30\uBCF8
      \uACF5\uACA9\uC744 \uAC15\uD654\uD569\uB2C8\uB2E4. 10\uCD08 \uC774\uB0B4\uC758
      \uB2E4\uC74C \uC138 \uBC88\uC758 \uAE30\uBCF8 \uACF5\uACA9\uC774 <color=#ff98ef>\uBB34\uC18D\uC131
      \uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uAC00\uD558\uB294 \uAC80\uAE30\uB97C
      \uBC1C\uC0AC\uD569\uB2C8\uB2E4. \uC2DC\uC804 \uC2DC \uB2E4\uB978 \uAE30\uBCF8
      \uACF5\uACA9 \uAC15\uD654 \uC2A4\uD0AC \uD6A8\uACFC\uB97C \uB300\uCCB4\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uAC80\uAE30\uC758
      \uC704\uB825 : 50 ATK</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784 : 11\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12
      : \uB9C8\uB098 25</color>"
  - Icon: {fileID: -740046128, guid: 3ae2edcc9fa761f42a495df1f0f62a29, type: 3}
