  m_Script: {fileID: 11500000, guid: 508fbac1fdf3ff045842b632c1de339c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  characterCode: 2
  characterName: "\uCE98\uB9AC\uC544"
  characterInfo: "\uC5D0\uC774\uC624\uC5B4\uC758 \uC218\uD638\uB300\uC758 \uC77C\uC6D0\uC778
    \uCE98\uB9AC\uC544\uB294 \uC774\uC720\uC5C6\uB294 \uAC15\uD568\uB9CC\uC744 \uCD94\uAD6C\uD588\uC5C8\uC2B5\uB2C8\uB2E4.
    \uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uC7A0\uC2DC \uAC15\uD568\uC744 \uCD94\uAD6C\uD558\uB294\uAC78
    \uC911\uB2E8\uD558\uACE0 \uAC15\uD568\uC758 \uC758\uBBF8\uB97C \uCC3E\uC544 \uBAA8\uD5D8\uC744
    \uB5A0\uB0AC\uB2E4.\n\n\uBB34\uAE30 : \uB9C8\uB825\uAD8C\uCD1D\n\uB9C8\uB825\uC744
    \uC774\uC6A9\uD574 \uBB3C\uB9AC\uC801 \uD615\uC0C1 \uD53C\uD574\uB97C \uC904
    \uC218 \uC788\uB294 \uB9C8\uBC95\uACF5\uD559\uC801 \uBB34\uAE30\uC785\uB2C8\uB2E4."
  passiveOn: 1
  passive:
    Icon: {fileID: -2001678608, guid: e61aa29d1f082b4469625103dea48216, type: 3}
    Name: "\uAD00\uD1B5 \uD0C4\uD658"
    Info: "\uAE30\uBCF8 \uACF5\uACA9\uC758 \uD0C4\uD658\uC740 \uAE30\uBCF8 \uACF5\uACA9\uB825\uBCF4\uB2E4
      \uB354 \uB0AE\uC740 \uD53C\uD574\uB97C \uC8FC\uACE0 \uCD5C\uB300 3\uBA85\uC758
      \uC801\uC744 \uAD00\uD1B5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC801\uC5D0\uAC8C
      \uACF5\uACA9 \uAE30\uC220\uB85C \uD53C\uD574\uB97C \uAC00\uD558\uBA74 \uC801\uC5D0\uAC8C
      <color=#ff0000>\uCD9C\uD608</color>\uC744 \uB0A8\uAE41\uB2C8\uB2E4. <color=#ff0000>\uCD9C\uD608</color>\uC740
      \uC801\uC5D0\uAC8C \uB9E4\uCD08 \uCCB4\uB825\uC5D0 \uBE44\uB840\uD55C <color=#78a6a6>\uACE0\uC815
      \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4. <color=#ff0000>\uCD9C\uD608</color>\uC5D0
      \uAC78\uB9B0 \uC801\uC744 \uAE30\uBCF8 \uACF5\uACA9\uD558\uBA74 \uCD94\uAC00
      <color=#ffffb7>\uBB34\uC18D\uC131 \uBB3C\uB9AC \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uAE30\uBCF8
      \uACF5\uACA9 \uC704\uB825 : 75 ATK </color>\n<color=#FFFF70>\uCD94\uAC00 \uD53C\uD574
      \uC704\uB825 : \uAE30\uBCF8 \uACF5\uACA9\uC758 50%</color>"
  skills:
  - Icon: {fileID: -1565285872, guid: f56a2e5c0b51d6f4b8a93f12a1b45b02, type: 3}
    skillCooltime: 0
    costKey: UltimatePoint
    cost: 250
    skillName: "\uCD08\uB9C8\uB825\uD0C4"
    skillInfo: "\uB9C8\uB825\uCD1D\uC5D0 \uC790\uC2E0\uC774 \uCD95\uC801\uD55C \uC5D0\uB108\uC9C0\uB97C
      \uC3DF\uC544\uBD80\uC5B4 \uAC15\uB825\uD55C \uACF5\uACA9\uC744 \uAC00\uD569\uB2C8\uB2E4.
      \uC7A0\uC2DC <color=#004dff>\uBB34\uC801</color>\uC0C1\uD0DC\uAC00 \uB418\uBA70
      \uC804\uBC29\uC5D0 3\uBC88\uC758 \uD0C4\uD658\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4.
      \uCCAB\uBC88\uC9F8\uC640 \uB450\uBC88\uC9F8 \uD0C4\uD658\uC740<color=#ff98ef>
      \uBB34\uC18D\uC131 \uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uC785\uD788\uACE0
      <color=#ffc662>\uB454\uD654</color>\uC2DC\uD0B5\uB2C8\uB2E4. \uC774\uD6C4 \uC138
      \uBC88\uC9F8 \uD0C4\uD658\uC740 \uB354\uC6B1 \uAC15\uD55C <color=#ff98ef> \uBB34\uC18D\uC131
      \uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uC785\uD788\uACE0 <color=#ffc662>\uC18D\uBC15</color>
      \uC2DC\uD0B5\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825 1250 INT(+ 1250ATK)</color>\n<color=#FFFF70>\uC138
      \uBC88\uC9F8 \uD0C4\uD658 \uC704\uB825 2750 INT(+ 2750ATK)</color>\n<color=#FF0055>\uAD81\uADF9\uAE30
      \uAC8C\uC774\uC9C0 250\uC744 \uCC44\uC6CC\uC57C \uBC1C\uB3D9\uD569\uB2C8\uB2E4</color>"
