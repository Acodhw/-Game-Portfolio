      \uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uC704\uB825 : 100INT</color>\n<color=#AAFFFF>\uCFE8\uD0C0\uC784
      : 8\uCD08</color>\n<color=#AAFFFF>\uC18C\uBAA8\uAC12 : \uB9C8\uB098 20</color>"
  - Icon: {fileID: 1684875063, guid: 8278790398948ba4daa2b49c8ca2cb8d, type: 3}
    skillCooltime: 13
    costKey: MP
    cost: 40
    skillName: "\uC131\uC6B4\uD3ED\uBC1C"
    skillInfo: "\uC8FC\uBCC0\uC73C\uB85C \uC131\uC6B4\uC744 \uB0A0\uB824 <color=#70e6f3>\uBC14\uB78C
      \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C
      \uC785\uD788\uACE0<color=#ffc662>\uB454\uD654 \uC2DC\uD0B5\uB2C8\uB2E4.</color>.
      \uC131\uC6B4\uC774 \uB2E4 \uCEE4\uC84C\uC744 \uACBD\uC6B0 \uC794\uC7AC\uD55C
      \uC131\uC6B4\uC774 \uB0A8\uC544 4\uCD08\uAC04 \uC794\uC7AC\uD55C \uC131\uC6B4
      \uBC94\uC704 \uC548\uC758 \uC801\uC744 \uD0DC\uC6CC \uC8FC\uAE30\uC801\uC73C\uB85C
      <color=#ff661a>\uBD88 \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C
      \uC785\uD799\uB2C8\uB2E4.\n<color=#FFFF70>\uC131\uC6B4\uC758 \uC704\uB825 : 
