  m_text: "\uC790\uC2E0\uC5D0\uAC8C \uBAA8\uC5EC\uB4DC\uB294 4\uAC1C\uC758 \uAD6C\uCCB4\uB97C
    \uC0DD\uC131\uD569\uB2C8\uB2E4. \uAC01 \uAD6C\uCCB4\uB294 1\uCD08 \uD6C4 \uC790\uC2E0\uCABD\uC73C\uB85C
    \uC624\uBA70 \uAC01 \uAD6C\uCCB4\uB294 <color=#eeee00>\uC804\uAE30 \uC18D\uC131</color>
    <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n\uC804\uAE30
