    \uC7AC\uC2DC\uC804 \uC2DC :\n\uC790\uC2E0 \uC8FC\uBCC0\uC5D0 <color=#c9ff99>\uBE5B
    \uC18D\uC131 <color=#ff98ef>\uB9C8\uBC95 \uD53C\uD574</color></color>\uB97C \uAC00\uD569\uB2C8\uB2E4.\n<color=#FFFF70>\uD558\uB098\uC758
