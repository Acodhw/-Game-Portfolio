      \uACF5\uC911\uC5D0\uC11C \uD68C\uC804\uBCA0\uAE30\uB97C \uD569\uB2C8\uB2E4"
  - SkillInfo:
    - "\uB099\uB8B0,\uB099\uB8B0\uB97C \uB5A8\uC5B4\uD2B8\uB824 \uD070 \uB370\uBBF8\uC9C0\uC640
      \uB9C8\uBE44\uB97C \uC90D\uB2C8\uB2E4"
    - "\uBCC4\uBE5B\uC815\uD654,\uC804\uBC29\uC73C\uB85C \uC9C0\uC18D\uB418\uB294
      \uBE5B\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4"
    - "\uC704\uC131\uBCF4\uD638,\uC801\uC744 \uBC00\uCCD0\uB0B4\uB294 \uC704\uC131\uC744
      \uC18C\uD658\uD55C \uD6C4 \uC790\uC2E0\uC5D0\uAC8C \uC18C\uB7C9\uC758 \uBCF4\uD638\uB9C9\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4"
  - SkillInfo:
    - "\uB09C\uC0AC,\uC8FC\uBCC0\uC73C\uB85C \uBE60\uB974\uAC8C \uD0C4\uD658\uC744
      \uB0A0\uB9BD\uB2C8\uB2E4."
    - "\uC800\uACA9,\uC57D\uAC04\uC758 \uC900\uBE44 \uD6C4, \uC6D0\uAC70\uB9AC\uC5D0\uC11C
      \uD070 \uC704\uB825\uC744 \uBC1C\uD718\uD558\uB294 \uD0C4\uD658\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4"
    - "\uD3ED\uBC1C \uD0C4\uD658,\uC5B4\uB518\uAC00\uC5D0 \uB2FF\uAC70\uB098 \uC77C\uC815
      \uC2DC\uAC04 \uD6C4 \uD3ED\uBC1C\uD558\uB294 \uD0C4\uD658\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4"
  - SkillInfo:
    - "\uCC0C\uB974\uAE30,\uC804\uBC29\uC73C\uB85C \uB2EC\uB9AC\uBA70 \uCC0C\uB985\uB2C8\uB2E4"
    - "\uC62C\uB824\uCE58\uAE30,\uC810\uD504\uD558\uBA70 \uC801\uC744 \uB744\uC6C1\uB2C8\uB2E4"
    - "\uCC3D \uB0B4\uB824\uCC0D\uAE30,\uACF5\uC911\uC5D0\uC11C \uCC3D\uC744 \uB0B4\uB824\uCC0D\uC740
      \uD6C4 \uADF8 \uC790\uB9AC\uC5D0 \uCDA9\uACA9\uD30C\uB97C \uD615\uC131\uD569\uB2C8\uB2E4"
  - SkillInfo:
    - "\uB3C4\uB07C \uB0B4\uB824\uCC0D\uAE30,\uB3C4\uB07C\uB97C \uC544\uB798\uB85C
      \uD718\uB450\uB978 \uD6C4 \uBC14\uB2E5\uC5D0 \uCDA9\uACA9\uD30C\uB97C \uD615\uC131\uD569\uB2C8\uB2E4"
    - "\uD68C\uC804\uBCA0\uAE30,\uC8FC\uC704\uB97C \uB3C4\uB07C\uB85C \uD718\uB450\uB985\uB2C8\uB2E4"
    - "\uB3C4\uB07C\uC758 \uC77C\uACA9,\uB3C4\uB07C\uB97C \uD718\uB458\uB7EC \uC801\uC744
      \uBC00\uCCD0\uB0B4\uB294 \uAE30\uC6B4\uC744 \uB0B4\uBCF4\uB0C5\uB2C8\uB2E4"
  - SkillInfo:
    - "\uC77C\uACA9\uD749\uD130,\uC804\uBC29 \uB113\uC740 \uBC94\uC704\uC5D0 \uACF5\uACA9\uD569\uB2C8\uB2E4"
    - "\uC0AC\uC2AC\uBD84\uB178,\uAE30\uB825\uC744 \uC774\uC6A9\uD574 \uC801\uC744
      \uB744\uC6C1\uB2C8\uB2E4"
    - "\uAE09\uC2B5\uD68C\uC804,\uC8FC\uBCC0\uC744 \uBE60\uB974\uAC8C \uD598\uD045\uB2C8\uB2E4."
  - SkillInfo:
    - "\uCF64\uBCF4\uD380\uCE58,\uC7AC\uBE60\uB978 \uACF5\uACA9 \uD6C4 \uC801\uC744
      \uB454\uD654\uC2DC\uD0A4\uB294 \uC77C\uACA9\uC744 \uB0A0\uB9BD\uB2C8\uB2E4"
    - "\uAE30\uACF5\uD380\uCE58,\uC7A0\uC2DC \uD6C4 \uAC00\uAE4C\uD788 \uC788\uB294
      \uC801\uC744 \uB354 \uBA40\uB9AC \uBC00\uCCD0\uB0B4\uACE0 \uBA40\uB9AC \uC788\uB294
      \uC801\uC5D0\uAC8C \uD070 \uB370\uBBF8\uC9C0\uB97C \uC8FC\uB294 \uC8FC\uBA39\uC744
      \uB0A0\uB9BD\uB2C8\uB2E4"
    - "\uB0B4\uB824\uCC0D\uAE30,\uACF5\uC911\uC5D0\uC11C \uC801\uC744 \uB0B4\uB824
      \uCC0D\uACE0, \uACF5\uC911\uC5D0 \uC788\uB294 \uC801\uC740 \uBC14\uB2E5\uC5D0\uC11C
      \uCDA9\uACA9\uD30C\uB97C \uD615\uC131\uD569\uB2C8\uB2E4."
  - SkillInfo:
    - "\uD6C4\uBC29\uC8FC\uC704,\uD6C4\uBC29\uC774 \uB354 \uAC15\uB825\uD55C \uACF5\uACA9\uC744
      \uD569\uB2C8\uB2E4"
    - "\uCC29\uCDE8\uD30C\uB3C4,\uC804\uBC29\uC5D0 \uCC29\uCDE8\uC758 \uD30C\uB3C4\uB97C
      \uB0A0\uB824 \uC801\uC744 \uBC00\uCCD0\uB0C5\uB2C8\uB2E4."
    - "\uBB18\uBE44\uAC74\uC124,\uC801\uC758 \uBB18\uBE44\uB97C \uAC74\uC124\uD558\uC5EC
      \uC8FC\uBCC0\uC5D0 \uC9C0\uC18D\uB51C\uC744 \uC90D\uB2C8\uB2E4"
  passiveTx:
  - "\uC0BC\uB2E8\uAC80\uACA9 : \uC5F0\uC18D\uB41C \uC138 \uBC88\uC758 \uC77C\uBC18
    \uACF5\uACA9\uC774 \uC801\uC744 \uBC00\uCCD0\uB0C4"
  - "\uBCC4\uC758 \uC9C0\uC6D0 : \uACF5\uACA9\uC774 \uBCC4\uC758 \uD754\uC801\uC744
    \uB0A8\uAE40. \uB2E4\uC74C \uACF5\uACA9\uC774 \uBCC4\uC758 \uD754\uC801\uC744
    \uD130\uD2B8\uB824 \uCD94\uAC00 \uB370\uBBF8\uC9C0"
  - "\uCD1D\uC54C \uC55E\uC5D0\uC120 : \uACF5\uACA9\uC774 \uCD9C\uD608\uC744 \uB0A8\uAE40.
    \uCD9C\uD608\uB41C \uC801\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574"
  - "\uD0DC\uC591\uC758 \uCC3D : \uAE30\uC220 \uBC0F \uC77C\uBC18 \uACF5\uACA9\uC73C\uB85C
    \uCF64\uBCF4\uB97C \uC313\uACE0, \uC804\uBD80 \uC313\uC774\uBA74 \uC8FC\uBCC0\uC5D0
    \uD070 \uD53C\uD574"
  - "\uBB35\uC9C1\uD55C \uD55C \uBC29 : \uC77C\uBC18 \uACF5\uACA9 \uBC0F \uAE30\uC220\uB85C
    4\uBC88 \uB9DE\uC740 \uC801\uC740 \uAE30\uC808"
  - "\uC740\uB454\uC220\uC0AC : \uC801\uC5D0\uAC8C \uB4E4\uD0A4\uC9C0 \uC54A\uACE0
    \uB4E4\uD0A4\uC9C0 \uC54A\uC740 \uC801\uC5D0\uAC8C \uACF5\uACA9 \uC2DC \uD070
    \uB370\uBBF8\uC9C0"
  - "\uAC74\uD2C0\uB81B\uC758 \uC815\uB839 : \uC801\uC5D0\uAC8C \uACF5\uACA9 \uC2DC
    \uAC74\uD2C0\uB81B\uC5D0 \uD798 \uCD95\uC801 \uD6C4 \uC77C\uC815\uB7C9 \uC774\uC0C1
    \uBAA8\uC774\uBA74 \uD070 \uBCF4\uD638\uB9C9\uACFC \uC77C\uBC18 \uACF5\uACA9
    \uAC15\uD654"
  - "\uC8FD\uC74C \uC55E\uC5D0\uC120 : \uC801\uC5D0\uAC8C \uB9DE\uCD98 \uBD80\uBA54\uB791\uC744
    \uC7A1\uC73C\uBA74 \uCCB4\uB825\uD68C\uBCF5, \uC77C\uC815 \uCCB4\uB825 \uC774\uD558\uC758
    \uBCF4\uC2A4\uAC00 \uC544\uB2CC \uC801\uC744 \uCC98\uD615"
